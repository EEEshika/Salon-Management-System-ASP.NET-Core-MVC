@model List<BLL.DTOs.StaffDTO>

<div style="min-height:85vh;
    background:linear-gradient(135deg,#fff5f8,#ffe6f0);
    padding:30px 0;">

    <div class="container">

        <div class="card shadow p-4"
             style="border-radius:18px;
            border:1px solid #f3a7c6;
            background-color:#fffafa;">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 style="color:#d63384;
                    font-weight:bold;">
                    👩‍💼 Staff List
                </h2>

                <a asp-controller="Staff"
                       asp-action="Create"
                       class="btn"
                       style="background-color:#d63384;
                    color:white;
                    font-weight:bold;
                    border-radius:10px;">
                    Add Staff
                </a>

            </div>

            @if (TempData["Msg"] != null)
            {
                <div class="alert @TempData["Class"] py-2 px-3"
                     style="width:fit-content; border-radius:10px; font-weight:bold;">
                    @TempData["Msg"]
                </div>
            }

            <table class="table table-bordered table-hover">

                <tr style="background-color:#fff0f5;">
                    <th>Name</th>
                    <th>Phone</th>
                    <th>Specialty</th>
                    <th>Experience</th>
                    <th>Action</th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Phone</td>
                        <td>@item.Specialty</td>
                        <td>@item.ExperienceYears Years</td>

                        <td>
                            <a asp-controller="Staff"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm"
                                   style="background-color:#f7b2d9;
                                color:#6f1240;
                                font-weight:bold;">
                                Update
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }

            </table>

        </div>

    </div>

</div>