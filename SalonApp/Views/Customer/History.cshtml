@model List<BLL.DTOs.AppointmentDTO>

<div style="min-height:85vh; background:linear-gradient(135deg,#fff5f8,#ffe6f0); padding:40px 0;">

    <div class="container">

        <div class="card shadow p-4"
             style="border-radius:20px; background-color:#fffafa; border:1px solid #f3a7c6;">

            <h1 style="color:#d63384; font-weight:bold;">
                📋 My Appointment History
            </h1>

            <hr />

            @if (TempData["Msg"] != null)
            {
                <div class="alert @TempData["Class"]">
                    @TempData["Msg"]
                </div>
            }

            <table class="table table-bordered table-hover mt-3">

                <thead style="background-color:#fff0f5;">
                    <tr>
                        <th>Staff Name</th>
                        <th>Service</th>
                        <th>Appointment Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                        <th>Payment</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StaffName</td>
                            <td>@item.ServiceName</td>
                            <td>@item.AppointmentDate</td>
                            <td>@item.Status</td>
                            <td>@item.Notes</td>
                            <td>
                                <a asp-controller="Payment"
                                       asp-action="Create"
                                       asp-route-appointmentId="@item.Id"
                                       class="btn btn-success btn-sm">
                                    Pay
                                </a>

                                <a asp-controller="Payment"
                                       asp-action="History"
                                       asp-route-appointmentId="@item.Id"
                                       class="btn btn-info btn-sm mt-1">
                                    History
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>