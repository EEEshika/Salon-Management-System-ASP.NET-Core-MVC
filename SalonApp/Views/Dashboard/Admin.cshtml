<div style="min-height:85vh;
    background:linear-gradient(135deg,#fff5f8,#ffe6f0);
    padding:40px 0;">

    <div class="container">

        <div class="text-center mb-5">

            <h1 style="color:#d63384;
                font-weight:bold;">
                💇‍♀️ Admin Dashboard
            </h1>

            <p style="color:#666; font-size:18px;">
                Manage your salon system easily
            </p>

        </div>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="card shadow h-100 p-4 text-center"
                     style="border-radius:18px;
                    background-color:#fffafa;">

                    <div style="font-size:50px;">💅</div>

                    <h3 style="color:#d63384;">Services</h3>

                    <p>
                        Add, edit and manage salon services.
                    </p>

                    <a asp-controller="Service"
                           asp-action="Index"
                           class="btn mt-2"
                           style="background-color:#d63384;
                        color:white;
                        border-radius:10px;">

                        Manage Services

                    </a>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow h-100 p-4 text-center"
                     style="border-radius:18px;
                    background-color:#fffafa;">

                    <div style="font-size:50px;">👩‍💼</div>

                    <h3 style="color:#d63384;">Staff</h3>

                    <p>
                        Manage staff information and activities.
                    </p>

                    <a asp-controller="Staff"
                           asp-action="Index"
                           class="btn mt-2"
                           style="background-color:#d63384;
                        color:white;
                        border-radius:10px;">

                        Manage Staff

                    </a>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow h-100 p-4 text-center"
                     style="border-radius:18px;
                    background-color:#fffafa;">

                    <div style="font-size:50px;">📅</div>

                    <h3 style="color:#d63384;">Appointments</h3>

                    <p>
                        View and manage customer appointments.
                    </p>

                    <a asp-controller="Appointment"
                       asp-action="Index"
                       class="btn mt-2"
                      style="background-color:#d63384;
                      color:white;
                      border-radius:10px;">

                       View Appointments

                        </a>

                   

                </div>

            </div>

        </div>

    </div>

</div>