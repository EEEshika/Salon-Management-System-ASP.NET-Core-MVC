@{
    ViewData["Title"] = "Home Page";
}

<div style="min-height:90vh;
            background:linear-gradient(135deg,#fff5f8,#ffe6f0);
            padding:50px 0;">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-md-6">

                <h1 style="font-size:55px;
                           font-weight:bold;
                           color:#d63384;">

                    Glow & Glam Salon 💇‍♀️

                </h1>

                <p style="font-size:20px;
                          color:#555;
                          margin-top:20px;">

                    Experience beauty, elegance, and self-care
                    with our premium salon services.

                </p>

                <div style="margin-top:35px;">

                    <a asp-controller="Auth"
                       asp-action="Login"
                       class="btn btn-lg"
                       style="background-color:#d63384;
                              color:white;
                              border-radius:12px;
                              padding:12px 30px;
                              margin-right:10px;">

                        Login

                    </a>

                    <a asp-controller="Auth"
                       asp-action="Register"
                       class="btn btn-lg"
                       style="border:2px solid #d63384;
                              color:#d63384;
                              border-radius:12px;
                              padding:12px 30px;">

                        Register

                    </a>

                </div>

            </div>

            <div class="col-md-6 text-center">

                <img src="https://cdn-icons-png.flaticon.com/512/6997/6997662.png"
                     width="350"
                     class="img-fluid"
                     style="border-radius:25px;
                filter:drop-shadow(0px 6px 12px rgba(0,0,0,0.2));" />

            </div>

        </div>

        <div class="row mt-5">

            <div class="col-md-4">

                <div class="card shadow p-4"
                     style="border-radius:18px; background-color:#fffafa;">

                    <h3 style="color:#d63384;">💅 Nail Care</h3>

                    <p>
                        Professional manicure and pedicure services.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow p-4"
                     style="border-radius:18px; background-color:#fffafa;">

                    <h3 style="color:#d63384;">💇 Hair Styling</h3>

                    <p>
                        Trendy haircuts and styling by experts.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card shadow p-4"
                     style="border-radius:18px; background-color:#fffafa;">

                    <h3 style="color:#d63384;">✨ Facial & Spa</h3>

                    <p>
                        Relaxing beauty treatments for glowing skin.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>