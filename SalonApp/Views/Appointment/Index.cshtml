@model List<BLL.DTOs.AppointmentDTO>

<div style="min-height:85vh; background:linear-gradient(135deg,#fff5f8,#ffe6f0); padding:30px 0;">

    <div class="container">

        <div class="card shadow p-4" style="border-radius:18px; border:1px solid #f3a7c6; background-color:#fffafa;">

            <div class="d-flex justify-content-between align-items-center mb-4">

                <h2 style="color:#d63384; font-weight:bold;">
                    📅 Appointment List
                </h2>

                <a asp-controller="Appointment"
                       asp-action="Create"
                       class="btn"
                       style="background-color:#d63384; color:white; font-weight:bold; border-radius:10px;">
                    Add Appointment
                </a>

            </div>

            @if (TempData["Msg"] != null)
            {
                <div class="alert @TempData["Class"] py-2 px-3"
                     style="width:fit-content; border-radius:10px; font-weight:bold;">
                    @TempData["Msg"]
                </div>
            }

            <table class="table table-bordered table-hover">

                <tr style="background-color:#fff0f5;">
                    <th>Customer Id</th>
                    <th>Staff Id</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Notes</th>
                    <th>Action</th>
                </tr>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CustomerId</td>
                        <td>@item.StaffId</td>
                        <td>@item.AppointmentDate</td>
                        <td>@item.Status</td>
                        <td>@item.Notes</td>

                        <td>
                            <a asp-controller="Appointment"
                                   asp-action="Update"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm"
                                   style="background-color:#f7b2d9; color:#6f1240; font-weight:bold;">
                                Update
                            </a>

                            <form asp-action="Delete" method="post" style="display:inline;">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-danger">
                                    Delete
                                </button>
                            </form>

                            

                            <a asp-controller="Payment"
                                   asp-action="History"
                                   asp-route-appointmentId="@item.Id"
                                   class="btn btn-info btn-sm">
                                Payment History
                            </a>
                        </td>
                    </tr>
                }

            </table>

        </div>

    </div>

</div>