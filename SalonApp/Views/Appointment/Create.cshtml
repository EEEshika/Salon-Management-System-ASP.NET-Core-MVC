@model BLL.DTOs.AppointmentDTO

<div style="min-height:85vh; background:linear-gradient(135deg,#fff5f8,#ffe6f0); padding:30px 0;">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow p-4"
                 style="border-radius:18px;
                border:1px solid #f3a7c6;
                background-color:#fffafa;">

                <h2 class="text-center mb-4"
                    style="color:#d63384; font-weight:bold;">

                    📅 Add Appointment

                </h2>

                <form method="post">

                    <div class="mb-3">

                        <label class="form-label">Customer</label>

                        <input type="text"
                               name="CustomerName"
                               class="form-control"
                               placeholder="Enter your name" />

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Staff</label>

                        <select name="StaffId" class="form-control">

                            <option value="">-- Select Staff --</option>

                            @foreach (var staff in ViewBag.Staffs)
                            {
                                <option value="@staff.Id">
                                    @staff.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Service</label>

                        <select name="ServiceId" class="form-control">

                            <option value="">-- Select Service --</option>

                            @foreach (var service in ViewBag.Services)
                            {
                                <option value="@service.Id">
                                    @service.Name - @service.Price
                                </option>
                            }

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label">Appointment Date</label>

                        <input type="datetime-local"
                               name="AppointmentDate"
                               class="form-control" />

                    </div>

                    <div class="mb-4">

                        <label class="form-label">Notes</label>

                        <textarea name="Notes"
                                  class="form-control"></textarea>

                    </div>

                    <input type="hidden"
                           name="Status"
                           value="Pending" />

                    <div class="d-grid">

                        <button type="submit"
                                class="btn"
                                style="background-color:#d63384;
                            color:white;
                            font-weight:bold;
                            border-radius:10px;">

                            Create

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>